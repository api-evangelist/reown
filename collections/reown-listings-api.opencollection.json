                "value": "",
                "type": "query",
                "description": "Comma-separated supported standards."
              }
            ]
          },
          "docs": "Returns hybrid listings (entries that are both wallets and dApps)."
        },
        {
          "info": {
            "name": "List all entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://explorer-api.walletconnect.com/v3/all",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query",
                "description": "Reown project ID."
              },
              {
                "name": "entries",
                "value": "",
                "type": "query",
                "description": "Number of entries per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Free-text search term."
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of listing identifiers to filter by."
              },
              {
                "name": "chains",
                "value": "",
                "type": "query",
                "description": "Comma-separated CAIP-2 chain identifiers (e.g. eip155:1)."
              },
              {
                "name": "platforms",
                "value": "",
                "type": "query",
                "description": "Comma-separated platforms (e.g. ios,android,web)."
              },
              {
                "name": "sdks",
                "value": "",
                "type": "query",
                "description": "Comma-separated SDKs to filter by."
              },
              {
                "name": "standards",
                "value": "",
                "type": "query",
                "description": "Comma-separated supported standards."
              }
            ]
          },
