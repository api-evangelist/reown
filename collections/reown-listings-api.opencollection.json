{
  "opencollection": "1.0.0",
  "info": {
    "name": "Reown Cloud Explorer Chains Listings API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "projectId",
      "value": "{{projectId}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Listings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List wallets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://explorer-api.walletconnect.com/v3/wallets",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query",
                "description": "Reown project ID."
              },
              {
                "name": "entries",
                "value": "",
                "type": "query",
                "description": "Number of entries per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Free-text search term."
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of listing identifiers to filter by."
              },
              {
                "name": "chains",
                "value": "",
                "type": "query",
                "description": "Comma-separated CAIP-2 chain identifiers (e.g. eip155:1)."
              },
              {
                "name": "platforms",
                "value": "",
                "type": "query",
                "description": "Comma-separated platforms (e.g. ios,android,web)."
              },
              {
                "name": "sdks",
                "value": "",
                "type": "query",
                "description": "Comma-separated SDKs to filter by."
              },
              {
                "name": "standards",
                "value": "",
                "type": "query",
                "description": "Comma-separated supported standards."
              }
            ]
          },
          "docs": "Returns wallet listings from the Cloud Explorer directory."
        },
        {
          "info": {
            "name": "List dApps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://explorer-api.walletconnect.com/v3/dapps",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "query",
                "description": "Reown project ID."
              },
              {
                "name": "entries",
                "value": "",
                "type": "query",
                "description": "Number of entries per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number."
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Free-text search term."
              },
              {
                "name": "ids",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of listing identifiers to filter by."
              },
              {
                "name": "chains",
                "value": "",
                "type": "query",
                "description": "Comma-separated CAIP-2 chain identifiers (e.g. eip155:1)."
              },
              {
                "name": "platforms",
                "value": "",
                "type": "query",
                "description": "Comma-separated platforms (e.g. ios,android,web)."
              },
              {
                "name": "sdks",
                "value": "",
                "type": "query",
                "description": "Comma-separated SDKs to filter by."
              },
              {
                "name": "standards",
                "value": "",
                "type": "query",
                "description": "Comma-separated supported standards."
              }
            ]
          },
          "docs": "Returns dApp listings from the Cloud Explorer directory."
        },
        {
